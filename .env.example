# Optional: Gmail SMTP so the enquiry form emails you (set in Vercel → Settings → Environment Variables).
# If unset, the form falls back to opening WhatsApp with the enquiry pre-filled.
# SMTP_PASS is a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Where enquiries are delivered (defaults to SMTP_USER)
ENQUIRY_TO=you@gmail.com
