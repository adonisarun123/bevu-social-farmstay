# Optional: Gmail SMTP so the enquiry form emails you (set in Vercel → Settings → Environment Variables).
# If unset, the form falls back to opening WhatsApp with the enquiry pre-filled.
# SMTP_PASS is a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Where enquiries are delivered (defaults to SMTP_USER)
ENQUIRY_TO=you@gmail.com
# Other SMTP providers: set host/port (465 = SSL, 587 = STARTTLS) and optionally a From address
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_FROM=hello@bevusocialfarmstay.com

# ── Booking backend ──────────────────────────────────────────────────────────
# Neon Postgres (project "Bevu Social Farmstay"); the pooled connection string from the Neon console.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Auth.js secret: run `openssl rand -base64 32`
AUTH_SECRET=
# Public URL (Vercel sets this automatically in production; needed locally for auth callbacks)
AUTH_URL=http://localhost:3000
# These emails become admin on registration (the very first account is admin regardless).
# One or many, comma-separated. Also receives admin notifications when ENQUIRY_TO is unset.
ADMIN_EMAIL=you@example.com,partner@example.com

# ── WhatsApp alerts to admins (Meta WhatsApp Cloud API, free tier) ────────────
# 1. business.facebook.com → WhatsApp → API setup: copy the Phone number ID and create a permanent
#    System User token with whatsapp_business_messaging permission.
# 2. Numbers to alert, international format without "+", comma-separated.
# 3. For unattended alerts, create and get approved a utility template with one {{1}} body variable
#    (e.g. "Bevu update: {{1}}") — without it, Meta only delivers inside a 24h window after that
#    number last messaged the business number.
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_ADMIN_NUMBERS=917795207779
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en
