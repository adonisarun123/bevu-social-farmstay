# Gmail SMTP for RSVP emails (set these in Vercel → Settings → Environment Variables)
# SMTP_PASS is a Gmail App Password, NOT the account password:
#   Google Account → Security → 2-Step Verification → App passwords → create one for "Mail"
SMTP_USER=ankit.r@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional: deliver RSVPs to a different inbox (defaults to SMTP_USER)
RSVP_TO=ankit.r@gmail.com
